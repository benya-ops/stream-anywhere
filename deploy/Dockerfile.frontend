# Stream Anywhere — frontend build served by nginx
FROM node:20-alpine AS build
WORKDIR /app/frontend

COPY frontend/package.json ./
COPY frontend/yarn.lock* ./
RUN yarn install --network-timeout 600000 || yarn install

COPY frontend/ ./

# Same-origin deployment: API is reverse-proxied under /api by nginx,
# so the backend URL is empty (relative requests).
ARG REACT_APP_BACKEND_URL=""
ENV REACT_APP_BACKEND_URL=$REACT_APP_BACKEND_URL
ENV DISABLE_ESLINT_PLUGIN=true
ENV CI=false
RUN yarn build

FROM nginx:alpine
COPY deploy/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/frontend/build /usr/share/nginx/html
EXPOSE 80
